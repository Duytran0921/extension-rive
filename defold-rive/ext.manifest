name: RiveExt

platforms:
    common:
        context:
            # The core libs under defold-rive/lib are always built with
            # scripting on - utils/rive-runtime/buildscripts/build_*.sh pass
            # --with_rive_scripting unconditionally, and libluau_vm.a sits in
            # every platform folder as proof. This extension's own sources
            # were not being given the same define, which was harmless until
            # rive-runtime v0.1.164 put a scripting-only parameter on
            # CommandQueue::loadFile:
            #
            #   FileHandle loadFile(std::vector<uint8_t>, FileListener*,
            #                       uint64_t
            #   #ifdef WITH_RIVE_SCRIPTING
            #                       , ScriptingContextFactory
            #   #endif
            #                      );
            #
            # so the lib exported the four-argument symbol while res_rive_data
            # and script_rive_cmd called the three-argument one, and the link
            # failed with "undefined symbol: rive::CommandQueue::loadFile".
            # Defining it here is what makes both halves agree, not a way of
            # turning scripting on - it is already on.
            defines:    ["WITH_RIVE_SCRIPTING"]
            symbols:    ["ResourceTypeRiveScene", "ResourceTypeRiveModel", "ResourceTypeRiveData", "ComponentTypeRive"]

    linux:
        context:
            flags:      ["-std=c++17", "-fno-rtti"]
            defines:    ["DM_GRAPHICS_USE_VULKAN", "RIVE_LINUX", "RIVE_VULKAN"]
            cxxShFlags:     ["-std=c++17", "-fno-rtti"]
            cxxLinkShFlags: ["-std=c++17"]

            excludeLibs: [platform, graphics]
            excludeSymbols: [GraphicsAdapterOpenGL]
            symbols: [GraphicsAdapterVulkan]
            libs: [platform_vulkan, graphics_vulkan, X11-xcb]
            dynamicLibs: [vulkan]
            linkFlags: []

    win32:
        context:
            defines:        ["_CRT_SECURE_NO_WARNINGS", "DM_RIVE_USE_OPENGL", "RIVE_WINDOWS", "RIVE_DESKTOP_GL"]
            flags:          ["-std=c++17", "-fno-rtti"]
            cxxShFlags:     ["-std=c++17", "-fno-rtti"]
            cxxLinkShFlags: ["-std=c++17"]
    osx:
        context:
            flags:      ["-std=c++17", "-fno-rtti"]
            excludeLibs: [platform, graphics]
            excludeSymbols: [GraphicsAdapterOpenGL]
            symbols: []
            libs: []
            frameworks: [Metal, IOSurface, QuartzCore]

    ios:
        context:
            flags: ["-std=c++17", "-fno-aligned-allocation", "-fno-rtti"]
            excludeLibs: [graphics]
            excludeSymbols: [GraphicsAdapterOpenGL]
            symbols: [GraphicsAdapterVulkan]
            libs: [graphics_vulkan, MoltenVK]
            frameworks: [Metal, IOSurface, QuartzCore, ImageIO, CoreText]

    web:
        context:
            defines: ["DM_RIVE_USE_OPENGL", "RIVE_WEBGL"]
            symbols: []
            excludeLibs: [rive_renderer_wagyu_gl, rive_renderer_wagyu]
            libs: []
            flags: ["-std=c++17", "-fno-rtti"]
            emscriptenLinkFlags: [GL_WORKAROUND_SAFARI_GETCONTEXT_BUG=0]
  
    android:
        context:
            defines:            ["DM_RIVE_USE_OPENGL", "RIVE_ANDROID"]
            excludeDynamicLibs: [GLESv2, GLESv1_CM]
            dynamicLibs:        [GLESv3]
            flags:              ["-std=c++17", "-fno-rtti"]

    armv7-android:
        context:
            defines:            ["DM_UNSUPPORTED_PLATFORM"]
